# 백엔드 환경변수 예시 (값이 없으면 application.yml 의 로컬 기본값 사용)
# Spring 은 .env 파일을 직접 읽지 않으므로, 실행 환경(배포 플랫폼, IDE 실행 설정)에 환경변수로 넣는다.

PORT=8080
FRONTEND_URL=http://localhost:5173

DB_URL=jdbc:postgresql://localhost:5433/livecraft
DB_USERNAME=livecraft
DB_PASSWORD=livecraft

# LiveKit (로컬: docker compose 의 개발 서버 / 운영: LiveKit Cloud 프로젝트 설정의 값)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_devsecret_change_me

# 토스페이먼츠 테스트 키 (개발자센터 > API 키 > 테스트 키, test_ck_ / test_sk_ 로 시작)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 심사용 테스트 로그인 버튼
TEST_LOGIN_ENABLED=true
TEST_ACCOUNT_PASSWORD=test1234!

RECORDING_DIR=./data/recordings
